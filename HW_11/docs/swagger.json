{
    "swagger": "2.0",
    "info": {
        "description": "Сервер для игры в шахматы. Сначала POST /login, потом нажать Authorize и вставить \"Bearer \u003cтокен\u003e\"",
        "title": "Шахматы API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/game": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Создать игру",
                "parameters": [
                    {
                        "description": "id белого и чёрного игрока",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.GameRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/game.Game"
                        }
                    },
                    "400": {
                        "description": "ошибка в данных",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/game/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Игра по id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/game.Game"
                        }
                    },
                    "400": {
                        "description": "неправильный id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игра не найдена",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Изменить игру можно только одним способом - сдаться. Сдаётся тот, чей сейчас ход",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Сдаться",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "action = surrender",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.GameUpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/game.Game"
                        }
                    },
                    "400": {
                        "description": "ошибка в данных",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игра не найдена",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "games"
                ],
                "summary": "Удалить игру",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "неправильный id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игра не найдена",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/games": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Список игр",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/game.Game"
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "Проверяет логин и пароль из .env и выдаёт JWT на 1 час",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Авторизация",
                "parameters": [
                    {
                        "description": "логин и пароль",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "неправильный json",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "неверный логин или пароль",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/move": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "moves"
                ],
                "summary": "Сделать ход",
                "parameters": [
                    {
                        "description": "номер игры и ход",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.MoveRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/move.Move"
                        }
                    },
                    "400": {
                        "description": "ошибка в данных или ход невозможен",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игра не найдена",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/move/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "moves"
                ],
                "summary": "Ход по id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id хода",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/move.Move"
                        }
                    },
                    "400": {
                        "description": "неправильный id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "ход не найден",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/moves": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "moves"
                ],
                "summary": "Список ходов",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/move.Move"
                            }
                        }
                    }
                }
            }
        },
        "/player": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "players"
                ],
                "summary": "Создать игрока",
                "parameters": [
                    {
                        "description": "имя и цвет (white или black)",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.PlayerRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/player.Player"
                        }
                    },
                    "400": {
                        "description": "ошибка в данных",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/player/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "players"
                ],
                "summary": "Игрок по id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id игрока",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/player.Player"
                        }
                    },
                    "400": {
                        "description": "неправильный id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игрок не найден",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Меняется только имя, цвет из запроса не используется",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "players"
                ],
                "summary": "Изменить имя игрока",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id игрока",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "новое имя",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.PlayerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/player.Player"
                        }
                    },
                    "400": {
                        "description": "ошибка в данных",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игрок не найден",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "players"
                ],
                "summary": "Удалить игрока",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id игрока",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "неправильный id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "нужна авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "игрок не найден",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/players": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "players"
                ],
                "summary": "Список игроков",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/player.Player"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "board.Board": {
            "type": "object",
            "properties": {
                "cells": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/piece.Piece"
                        }
                    }
                }
            }
        },
        "game.Game": {
            "type": "object",
            "properties": {
                "black": {
                    "$ref": "#/definitions/player.Player"
                },
                "board": {
                    "$ref": "#/definitions/board.Board"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "moves": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/move.Move"
                    }
                },
                "status": {
                    "description": "active или finished",
                    "type": "string",
                    "example": "active"
                },
                "turn": {
                    "type": "string",
                    "example": "white"
                },
                "white": {
                    "$ref": "#/definitions/player.Player"
                },
                "winner": {
                    "type": "string",
                    "example": "black"
                }
            }
        },
        "move.Move": {
            "type": "object",
            "properties": {
                "from_col": {
                    "type": "integer",
                    "example": 4
                },
                "from_row": {
                    "type": "integer",
                    "example": 6
                },
                "game_id": {
                    "type": "integer",
                    "example": 1
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "notation": {
                    "type": "string",
                    "example": "♟ E2-E4"
                },
                "piece": {
                    "$ref": "#/definitions/piece.Piece"
                },
                "to_col": {
                    "type": "integer",
                    "example": 4
                },
                "to_row": {
                    "type": "integer",
                    "example": 4
                }
            }
        },
        "piece.Piece": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string",
                    "example": "white"
                },
                "symbol": {
                    "type": "string",
                    "example": "♟"
                },
                "type": {
                    "type": "string",
                    "example": "pawn"
                }
            }
        },
        "player.Player": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string",
                    "example": "white"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "Аня"
                }
            }
        },
        "server.GameRequest": {
            "type": "object",
            "properties": {
                "black_id": {
                    "type": "integer",
                    "example": 2
                },
                "white_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "server.GameUpdateRequest": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "example": "surrender"
                }
            }
        },
        "server.LoginRequest": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string",
                    "example": "admin"
                },
                "password": {
                    "type": "string",
                    "example": "поменяй_меня"
                }
            }
        },
        "server.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                }
            }
        },
        "server.MoveRequest": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "string",
                    "example": "E2"
                },
                "game_id": {
                    "type": "integer",
                    "example": 1
                },
                "to": {
                    "type": "string",
                    "example": "E4"
                }
            }
        },
        "server.PlayerRequest": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string",
                    "example": "white"
                },
                "name": {
                    "type": "string",
                    "example": "Аня"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите: Bearer \u003cтокен\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}